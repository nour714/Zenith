# Zenith Configuration

# PostgreSQL connection string (Supabase). Use the pooled/transaction connection
# string from your Supabase project's Database settings for serverless deployments.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Add your optional Google Gemini API Key here or in the web UI settings modal:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
HOST=127.0.0.1
PORT=8000
